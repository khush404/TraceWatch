{
  "uid": "tracewatch-failure",
  "title": "TraceWatch – Failure Simulation",
  "tags": ["tracewatch", "failure"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(increase(payment_requests_total[5m]))",
        "legendFormat": "Total"
      }],
      "options": { "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } }
    },
    {
      "id": 2,
      "title": "Successful Payments",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(increase(payment_requests_total{status=\"success\"}[5m]))",
        "legendFormat": "Success"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 3,
      "title": "Failed Payments (HTTP 500)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(increase(payment_requests_total{status=\"failed\"}[5m]))",
        "legendFormat": "Failed"
      }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }] } } }
    },
    {
      "id": 4,
      "title": "Payment Error Rate %",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "100 * sum(increase(payment_requests_total{status=\"failed\"}[5m])) / (sum(increase(payment_requests_total[5m])) > 0)",
        "legendFormat": "Error %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10 }] } } }
    },
    {
      "id": 5,
      "title": "Order Requests (Success vs Failed)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(order_requests_total{status=\"success\"}[1m]))", "legendFormat": "Orders Success" },
        { "expr": "sum(rate(order_requests_total{status=\"payment_failed\"}[1m]))", "legendFormat": "Orders Payment Failed" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "title": "Payment Requests (Success vs Failed)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(payment_requests_total{status=\"success\"}[1m]))", "legendFormat": "Payment Success" },
        { "expr": "sum(rate(payment_requests_total{status=\"failed\"}[1m]))", "legendFormat": "Payment Failed (HTTP 500)" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "title": "Payment Duration p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(payment_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(payment_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(payment_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8,
      "title": "Notification Requests",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(notification_requests_total{status=\"success\"}[1m]))", "legendFormat": "Notifications Sent" },
        { "expr": "sum(rate(notification_requests_total{status=\"failed\"}[1m]))", "legendFormat": "Notifications Failed" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}
